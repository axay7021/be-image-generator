# App
APP_NAME="Image Modifier"
DEBUG=True
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ============================================
# Admin Authentication (JWT based)
# ============================================
# Format: email1:password1,email2:password2
# Only admins listed here can login to the system
# Example:
ADMIN_CREDENTIALS="admin@example.com:SecurePassword123,superadmin@example.com:AnotherSecurePass456"

# JWT Secrets (generate these with secure random strings)
ADMIN_JWT_SECRET="change_this_to_secure_admin_jwt_secret"
ADMIN_JWT_SECRET_REF="change_this_to_secure_admin_refresh_secret"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# Authentication
# ============================================
SECRET_KEY=change_this_to_secure_random
ALGORITHM=HS256
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# ============================================
# Stripe
# ============================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# Razorpay
# ============================================

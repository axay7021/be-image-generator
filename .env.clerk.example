# ============================================
# Clerk Authentication (Next.js Frontend)
# ============================================
# Get your keys from: https://dashboard.clerk.com/

# REQUIRED: Your Clerk Secret Key (starts with sk_test_ or sk_live_)
# This is the ONLY required variable - the SDK uses it to verify tokens
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# OPTIONAL: For frontend reference only (not used by backend)
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# OPTIONAL: JWKS URL (only needed as fallback if SDK verification fails)
# Leave empty for local development - it's auto-derived from your secret key
# Format: https://[your-domain].clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=

# Note: Even in local development, tokens are verified against Clerk's hosted service
# Your FastAPI runs locally, but Clerk authentication happens in the cloud
